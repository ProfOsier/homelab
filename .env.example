# Merge these into the existing /opt/homelab/.env; do not replace that file.
# Retain the current account and data directory for the installed OpenObserve.
APPDATA=/mnt/truenas
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=
OPENOBSERVE_LOKI_URL=http://openobserve:5080/api/default/loki/api/v1/push
# Use the existing ingestion credentials. These may differ from the root login.
OPENOBSERVE_INGEST_USER=
OPENOBSERVE_INGEST_PASSWORD=
